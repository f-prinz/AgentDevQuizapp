{
  "name": "@raccoons/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts"
  },
  "dependencies": {
    "@raccoons/contracts": "file:../../contracts",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
